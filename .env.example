# PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/douyintv?schema=public"
# API
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
COOKIE_SECURE=false
# Google OAuth (optional until configured)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"
# Stage 2 media infrastructure
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
# TMDB metadata (optional)
TMDB_API_KEY=""
# Payments intentionally disabled in this first stage
# Client API URL (set in client/.env for Vite)
VITE_API_URL="http://localhost:4000"
