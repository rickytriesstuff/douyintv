# SQLite database stored inside server/prisma by default
DATABASE_URL="file:./dev.db"
# API server
PORT=4000
PUBLIC_API_URL="https://your-api-host.example.com"
MEDIA_DIR="./server/uploads"
CLIENT_ORIGIN="http://localhost:5173"
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
COOKIE_SECURE=false
# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"
# TMDB metadata (optional)
TMDB_API_KEY=""
# Client API URL (set in client/.env for Vite)
VITE_API_URL="http://localhost:4000"

# Google Cloud Storage (optional; uses local disk when unset)
GCS_BUCKET_NAME=""
GOOGLE_CLOUD_PROJECT=""
# Configure ONE secure server-side credential method:
# GOOGLE_APPLICATION_CREDENTIALS="/secure/path/service-account.json"
# GOOGLE_CLOUD_KEY_JSON="{...service account JSON...}"
